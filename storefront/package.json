{
  "name": "e-buy-storefront",
  "private": true,
  "version": "1.0.0",
  "description": "E-Buy Uganda storefront: React + TypeScript + Tailwind CSS + Lucide",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
