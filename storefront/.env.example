# Leave both unset to run the storefront against built-in demo listings.
# Set both to load live listings from the existing Supabase `products` table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the legacy static pages (login.html, product-detail.html, ...) are served from.
# Default "../" works when the storefront lives in /storefront next to them.
VITE_LEGACY_SITE_BASE=../
